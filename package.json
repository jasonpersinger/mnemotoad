{
  "name": "mnemobard",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "main.js",
  "packageManager": "pnpm@10.29.3",
  "engines": { "node": ">=26.0.0" },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "pnpm typecheck && node esbuild.config.mjs --production",
    "build:dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:vault": "node scripts/dev-vault.mjs",
    "dev:obsidian": "node scripts/dev-obsidian.mjs",
    "test:obsidian": "node scripts/obsidian-smoke.mjs"
  },
  "dependencies": { "yaml": "2.9.1" },
  "pnpm": { "overrides": { "minimatch": "11.0.1" } },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
